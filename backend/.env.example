# Copie para .env e preencha com os valores reais.
#   cp .env.example .env
# O .env está no .gitignore e nunca é versionado.

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Trello ---
# Chave e token: https://trello.com/power-ups/admin  →  API Key / Token
TRELLO_API_KEY=
TRELLO_TOKEN=

# IDs das colunas de destino no board da EXPANSAO OSASCO.
# Descubra rodando: python get_trello_lists.py "EXPANSAO"
TRELLO_LIST_ID_IDEIAS=preencher_depois
TRELLO_LIST_ID_TAREFAS=preencher_depois

# --- Servidor (opcionais) ---
HOST=127.0.0.1
PORT=8000
TIMEZONE=America/Sao_Paulo
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
