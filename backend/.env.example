# Copie para .env e preencha com os valores reais.
#   cp .env.example .env
# O .env está no .gitignore e nunca é versionado.

# ───────────────────────── Google Gemini ─────────────────────────
GEMINI_API_KEY=
# Se o modelo abaixo sair do ar, troque aqui (ex.: gemini-2.5-flash).
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────── Trello ──────────────────────────────
# Chave e token: https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=

# IDs das colunas de destino. Descubra pelo painel (aba Configuração)
# ou rodando: python get_trello_lists.py "EXPANSAO"
TRELLO_LIST_ID_IDEIAS=preencher_depois
TRELLO_LIST_ID_TAREFAS=preencher_depois

# ────────────────────────── Servidor ─────────────────────────────
# 127.0.0.1 = só este Mac. 0.0.0.0 = visível na rede local (use com SERVER_TOKEN).
HOST=127.0.0.1
PORT=8000
TIMEZONE=America/Sao_Paulo
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO

# Senha para acesso de outros aparelhos. Em branco = sem senha (só faz sentido
# quando HOST=127.0.0.1). Quem abre no próprio Mac nunca precisa dela.
SERVER_TOKEN=

# Fila offline: banco local e intervalo (segundos) entre varreduras de reenvio.
DB_PATH=
FILA_INTERVALO=20

# ────────────────────────── WhatsApp ─────────────────────────────
# nenhum | evolution | meta | generico
#   evolution → Evolution API (self-hosted, lê grupos) — veja whatsapp/README.md
#   meta      → WhatsApp Cloud API oficial (NÃO entrega mensagens de grupo)
#   generico  → Atalhos do iOS, n8n, Make, Zapier…
WHATSAPP_PROVIDER=nenhum

# Filtro de grupos, separados por vírgula. Em branco = aceita todos os grupos.
WHATSAPP_GRUPOS=EXPANSAO OSASCO

# Ignorar as mensagens enviadas pelo próprio número conectado.
WHATSAPP_IGNORAR_PROPRIAS=sim

# evolution/generico: valor esperado no cabeçalho `apikey` do webhook.
WHATSAPP_API_KEY=

# meta: token do handshake e segredo do app (assinatura X-Hub-Signature-256).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
