# Copie para .env nesta pasta:  cp .env.exemplo .env
# Esta chave protege a Evolution API e é a mesma que vai em WHATSAPP_API_KEY
# no .env do Cérebro (backend/.env).
EVOLUTION_API_KEY=troque-por-uma-senha-longa

# Nome da instância (aparece na Evolution API).
INSTANCIA=cerebro

# Porta do Cérebro no Mac — o container usa host.docker.internal para alcançar.
CEREBRO_PORTA=8000
